decl @getint(): i32
decl @getch(): i32
decl @getarray(*i32): i32
decl @putint(i32)
decl @putch(i32)
decl @putarray(i32, *i32)
decl @starttime()
decl @stoptime()
global @n = alloc i32, zeroinit
fun @sort(@n: i32, @arr: *i32) {
%entry:
  @n_0 = alloc i32
  %0 = sub @n, 0
  store %0, @n_0
  @arr_1 = alloc *i32
  %1 = getptr @arr, 0
  store %1, @arr_1
  store 0, @n_0
  ret
}
fun @main(): i32 {
%entry:
  @arr_2 = alloc [i32, 5]
  %0 = getelemptr @arr_2, 0
  call @sort(5, %0)
  ret 0
}
