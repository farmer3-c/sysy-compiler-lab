decl @getint(): i32
decl @getch(): i32
decl @getarray(*i32): i32
decl @putint(i32)
decl @putch(i32)
decl @putarray(i32, *i32)
decl @starttime()
decl @stoptime()
fun @f(@arr: *[i32, 10]): i32 {
%entry:
  @arr_0 = alloc *[i32, 10]
  %0 = getptr @arr, 0
  store %0, @arr_0
  %1 = load @arr_0
  %2 = getptr %1, 0
  %3 = getelemptr %2, 1
  %4 = load %3
  ret %4
}
fun @main(): i32 {
%entry:
  @a_1 = alloc [[i32, 10], 10]
  %0 = getelemptr @a_1, 0
  %1 = getelemptr %0, 1
  store 42, %1
  %2 = getelemptr @a_1, 0
  %3 = call @f(%2)
  ret %3
}
